generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  APPLICANT
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id                String            @id @default(uuid()) @db.Uuid
  fullName          String            @map("full_name") @db.VarChar(120)
  email             String            @unique @db.VarChar(255)
  passwordHash      String            @map("password_hash") @db.Text
  role              UserRole          @default(APPLICANT)
  status            UserStatus        @default(ACTIVE)
  passwordChangedAt DateTime?         @map("password_changed_at") @db.Timestamptz()
  lastLoginAt       DateTime?         @map("last_login_at") @db.Timestamptz()
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz()

  profile           ApplicantProfile?
  sessions          Session[]
  documents         ApplicantDocument[]
  applications      JobApplication[]
  statusChanges     ApplicationStatusHistory[]
  adminReviewNotes  ApplicationReviewNote[]
  receivedOffers    JobOffer[]                  @relation("ApplicantOffers")
  createdOffers     JobOffer[]                  @relation("AdminCreatedOffers")

  @@index([role, status])
  @@map("users")
}

model ApplicantProfile {
  userId                    String    @id @map("user_id") @db.Uuid
  user                      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone                     String?   @db.VarChar(25)
  currentLocation           String?   @map("current_location") @db.VarChar(160)
  highestQualification      String?   @map("highest_qualification") @db.VarChar(120)
  collegeUniversity         String?   @map("college_university") @db.VarChar(180)
  graduationYear            Int?      @map("graduation_year") @db.SmallInt
  technicalSkills           String[]  @map("technical_skills")
  totalExperienceYears      Decimal?  @map("total_experience_years") @db.Decimal(4, 1)
  currentOrPreviousEmployer String?   @map("current_or_previous_employer") @db.VarChar(180)
  linkedinUrl               String?   @map("linkedin_url") @db.Text
  githubUrl                 String?   @map("github_url") @db.Text
  portfolioUrl              String?   @map("portfolio_url") @db.Text
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt                 DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("applicant_profiles")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.Text
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz()
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz()

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

// ==========================================
// Phase 3 Enums (SRS Section 3, 10 & 12)
// ==========================================
enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum WorkMode {
  ON_SITE
  HYBRID
  REMOTE
}

enum EnquiryStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

// ==========================================
// 1. Company Profile (SRS Section 1.3, 3.1 & 10.1)
// ==========================================
model CompanyProfile {
  id                   String   @id @default(uuid()) @db.Uuid
  companyName          String   @map("company_name") @db.VarChar(160)
  logoUrl              String?  @map("logo_url") @db.Text
  shortDescription     String   @map("short_description") @db.VarChar(500)
  about                String   @db.Text
  mission              String   @db.Text
  vision               String   @db.Text
  areasOfExpertise     String[] @default([]) @map("areas_of_expertise")
  businessCapabilities String[] @default([]) @map("business_capabilities")
  email                String   @db.VarChar(255)
  careersEmail         String?  @map("careers_email") @db.VarChar(255)
  phone                String   @db.VarChar(60)
  secondaryPhone       String?  @map("secondary_phone") @db.VarChar(60)
  address              String   @db.Text
  operatingHours       String?  @map("operating_hours") @db.VarChar(255)
  websiteUrl           String?  @map("website_url") @db.VarChar(255)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("company_profiles")
}

// ==========================================
// 2. Company Services Catalog (SRS Section 3.3 & 10.5)
// ==========================================
model Service {
  id               String   @id @default(uuid()) @db.Uuid
  title            String   @db.VarChar(160)
  slug             String   @unique @db.VarChar(180)
  category         String   @db.VarChar(100)
  shortDescription String   @map("short_description") @db.VarChar(320)
  fullDescription  String?  @map("full_description") @db.Text
  capabilities     String[] @default([])
  techStack        String[] @default([]) @map("tech_stack")
  iconName         String?  @map("icon_name") @db.VarChar(60)
  imageUrl         String?  @map("image_url") @db.Text
  displayOrder     Int      @default(0) @map("display_order") @db.SmallInt
  isPublished      Boolean  @default(false) @map("is_published")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([isPublished, displayOrder])
  @@map("services")
}

// ==========================================
// 3. Job Postings / Vacancies (SRS Section 3.4, 3.5 & 10.2)
// ==========================================
model Job {
  id                     String         @id @default(uuid()) @db.Uuid
  jobCode                String         @unique @map("job_code") @db.VarChar(50)
  title                  String         @db.VarChar(180)
  department             String         @db.VarChar(120)
  location               String         @db.VarChar(140)
  employmentType         EmploymentType @default(FULL_TIME) @map("employment_type")
  workMode               WorkMode       @default(HYBRID) @map("work_mode")
  experienceRequired     String         @map("experience_required") @db.VarChar(80)
  salaryRange            String?        @map("salary_range") @db.VarChar(100)
  description            String         @db.Text
  responsibilities       String[]       @default([])
  requiredQualifications String[]       @default([]) @map("required_qualifications")
  requiredSkills         String[]       @default([]) @map("required_skills")
  preferredSkills        String[]       @default([]) @map("preferred_skills")
  numberOfOpenings       Int?           @default(1) @map("number_of_openings") @db.SmallInt
  applicationDeadline    DateTime?      @map("application_deadline") @db.Timestamptz()
  status                 JobStatus      @default(DRAFT)
  isFeatured             Boolean        @default(false) @map("is_featured")
  publishedAt            DateTime?      @map("published_at") @db.Timestamptz()
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt              DateTime       @updatedAt @map("updated_at") @db.Timestamptz()

  applications           JobApplication[]
  offers                 JobOffer[]

  @@index([status, applicationDeadline])
  @@index([department, workMode])
  @@map("jobs")
}

// ==========================================
// 4. Contact Enquiries (SRS Section 3.6 & 10.6)
// ==========================================
model ContactEnquiry {
  id         String        @id @default(uuid()) @db.Uuid
  fullName   String        @map("full_name") @db.VarChar(120)
  email      String        @db.VarChar(255)
  phone      String?       @db.VarChar(30)
  subject    String        @db.VarChar(200)
  message    String        @db.Text
  status     EnquiryStatus @default(NEW)
  adminNotes String?       @map("admin_notes") @db.Text
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime      @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([status, createdAt])
  @@map("contact_enquiries")
}

// ==========================================
// 5. Resume & Certificate Documents (SRS v1.2 Phase 1)
// ==========================================
enum DocumentType {
  RESUME
  EDUCATIONAL_CERTIFICATE
  INTERNSHIP_CERTIFICATE
  EXPERIENCE_CERTIFICATE
  OTHER
}

model ApplicantDocument {
  id               String       @id @default(uuid()) @db.Uuid
  userId           String       @map("user_id") @db.Uuid
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type             DocumentType
  originalFilename String       @map("original_filename") @db.VarChar(255)
  storageKey       String       @unique @map("storage_key") @db.VarChar(500)
  mimeType         String       @map("mime_type") @db.VarChar(100)
  fileSizeBytes    Int          @map("file_size_bytes")
  checksumSha256   String?      @map("checksum_sha256") @db.VarChar(64)
  isArchived       Boolean      @default(false) @map("is_archived")
  deletedAt        DateTime?    @map("deleted_at") @db.Timestamptz()
  applicationCount Int          @default(0) @map("application_count")
  metadata         Json?
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz()

  applications     JobApplication[]

  @@index([userId, type, deletedAt])
  @@index([userId, isArchived])
  @@map("applicant_documents")
}

// ==========================================
// 6. Job Applications & Document Snapshots (SRS v1.2 Phase 2)
// ==========================================
enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW_SCHEDULED
  SELECTED
  REJECTED
  OFFER_EXTENDED
  HIRED
  WITHDRAWN
}

enum OfferStatus {
  DRAFT
  ISSUED
  ACCEPTED
  DECLINED
  EXPIRED
  WITHDRAWN
}

model JobApplication {
  id                    String                      @id @default(uuid()) @db.Uuid
  referenceNumber       String                      @unique @map("reference_number") @db.VarChar(50)
  applicantId           String                      @map("applicant_id") @db.Uuid
  applicant             User                        @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  jobId                 String                      @map("job_id") @db.Uuid
  job                   Job                         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status                ApplicationStatus           @default(SUBMITTED)
  resumeId              String?                     @map("resume_id") @db.Uuid
  resume                ApplicantDocument?          @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  coverNote             String?                     @map("cover_note") @db.Text
  noticePeriod          String?                     @map("notice_period") @db.VarChar(60)
  privacyAcknowledgedAt DateTime                    @map("privacy_acknowledged_at") @db.Timestamptz()
  privacyNoticeVersion  String                      @map("privacy_notice_version") @db.VarChar(20)
  submittedAt           DateTime                    @default(now()) @map("submitted_at") @db.Timestamptz()
  withdrawnAt           DateTime?                   @map("withdrawn_at") @db.Timestamptz()
  withdrawalReason      String?                     @map("withdrawal_reason") @db.Text
  applicantSnapshot     Json                        @map("applicant_snapshot")
  createdAt             DateTime                    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt             DateTime                    @updatedAt @map("updated_at") @db.Timestamptz()

  documents             ApplicationDocumentSnapshot[]
  statusHistory         ApplicationStatusHistory[]
  reviewNotes           ApplicationReviewNote[]
  offer                 JobOffer?

  @@unique([applicantId, jobId])
  @@index([applicantId, status])
  @@index([jobId, status])
  @@index([referenceNumber])
  @@map("job_applications")
}

model ApplicationDocumentSnapshot {
  id               String         @id @default(uuid()) @db.Uuid
  applicationId    String         @map("application_id") @db.Uuid
  application      JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  documentId       String?        @map("document_id") @db.Uuid
  documentType     DocumentType   @map("document_type")
  originalFilename String         @map("original_filename") @db.VarChar(255)
  storageKey       String         @map("storage_key") @db.VarChar(500)
  mimeType         String         @map("mime_type") @db.VarChar(100)
  fileSizeBytes    Int            @map("file_size_bytes")
  checksumSha256   String?        @map("checksum_sha256") @db.VarChar(64)
  isResume         Boolean        @default(false) @map("is_resume")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz()

  @@index([applicationId, isResume])
  @@index([documentId])
  @@map("application_documents")
}

model ApplicationStatusHistory {
  id                      String            @id @default(uuid()) @db.Uuid
  applicationId           String            @map("application_id") @db.Uuid
  application             JobApplication    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  previousStatus          ApplicationStatus @map("previous_status")
  newStatus               ApplicationStatus @map("new_status")
  changedById             String            @map("changed_by_id") @db.Uuid
  changedBy               User              @relation(fields: [changedById], references: [id], onDelete: Cascade)
  applicantVisibleRemarks String?           @map("applicant_visible_remarks") @db.Text
  internalRemarks         String?           @map("internal_remarks") @db.Text
  createdAt               DateTime          @default(now()) @map("created_at") @db.Timestamptz()

  @@index([applicationId])
  @@index([changedById])
  @@map("application_status_history")
}

model ApplicationReviewNote {
  id            String         @id @default(uuid()) @db.Uuid
  applicationId String         @map("application_id") @db.Uuid
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  adminId       String         @map("admin_id") @db.Uuid
  admin         User           @relation(fields: [adminId], references: [id], onDelete: Cascade)
  note          String         @db.Text
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([applicationId])
  @@index([adminId])
  @@map("application_review_notes")
}

// ==========================================
// 7. Offer Management (SRS Section 9.8 & 10.1)
// ==========================================
model JobOffer {
  id                 String         @id @default(uuid()) @db.Uuid
  offerCode          String         @unique @map("offer_code") @db.VarChar(50)
  applicationId      String         @unique @map("application_id") @db.Uuid
  application        JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicantId        String         @map("applicant_id") @db.Uuid
  applicant          User           @relation("ApplicantOffers", fields: [applicantId], references: [id], onDelete: Cascade)
  jobId              String         @map("job_id") @db.Uuid
  job                Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdById        String         @map("created_by_id") @db.Uuid
  createdBy          User           @relation("AdminCreatedOffers", fields: [createdById], references: [id])
  status             OfferStatus    @default(DRAFT)
  salary             Decimal?       @db.Decimal(12, 2)
  currency           String         @default("INR") @db.VarChar(10)
  designation        String         @db.VarChar(150)
  joiningDate        DateTime?      @map("joining_date") @db.Timestamptz()
  expiryDate         DateTime?      @map("expiry_date") @db.Timestamptz()
  termsAndConditions String?        @map("terms_and_conditions") @db.Text
  issuedAt           DateTime?      @map("issued_at") @db.Timestamptz()
  respondedAt        DateTime?      @map("responded_at") @db.Timestamptz()
  responseNotes      String?        @map("response_notes") @db.Text
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([applicantId, status])
  @@index([jobId, status])
  @@map("job_offers")
}



