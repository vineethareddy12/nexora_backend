# ==============================================================================
# Nexora Technologies - Environment Configuration Template
# Copy this file to .env in your root or server directory and fill in actual values.
# NEVER commit .env to source control!
# ==============================================================================

# Application & Server
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173,https://nexora-mu-two.vercel.app,https://nexora-backend-uqvc.onrender.com

# Database (PostgreSQL - Used in Phase 2)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/nexora_db?schema=public"

# Authentication & Security (Used in Phase 2)
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_min
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=super_secret_refresh_key_at_least_32_characters_long
JWT_REFRESH_EXPIRES_IN=7d

# Initial Admin Credentials (For prisma seed in Phase 2)
ADMIN_DEFAULT_EMAIL=admin@nexoratech.com
ADMIN_DEFAULT_PASSWORD=AdminSecurePassword2026!

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Documentation & API Controls
SWAGGER_ENABLED=true

# Storage Settings (Phase 4 & 7)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage/private
MAX_UPLOAD_SIZE_BYTES=5242880

# Email Service (Nodemailer / SMTP - Phase 6)
EMAIL_ENABLED=false
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Nexora Recruitment <careers@nexoratech.com>"

# Feature Flags
OFFER_RESPONSE_ENABLED=true
