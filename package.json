{
  "name": "nexora-server",
  "version": "1.0.0",
  "description": "Nexora Technologies API Backend",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "prisma migrate deploy && node prisma/seed.js && node src/server.js",
    "build": "prisma generate",
    "postinstall": "prisma generate",
    "dev": "node --watch src/server.js",
    "db:clean": "node scripts/clean-dummy-data.js",
    "db:check": "node scripts/check-db.js",
    "db:seed": "node prisma/seed.js",
    "reset:admin": "node scripts/clean-dummy-data.js",
    "test:company": "node src/app/company/company.test.js",
    "test:services": "node src/app/services/services.test.js",
    "test:jobs": "node src/app/jobs/jobs.test.js",
    "test:enquiries": "node src/app/enquiries/enquiries.test.js",
    "test:modules": "node src/app/company/company.test.js && node src/app/services/services.test.js && node src/app/jobs/jobs.test.js && node src/app/enquiries/enquiries.test.js",
    "test": "node tests/phase1-verification.test.js",
    "test:phase2": "node tests/phase2-verification.test.js",
    "test:phase3": "node tests/phase3-verification.test.js"
  },
  "dependencies": {
    "@prisma/client": "^6.4.0",
    "@supabase/supabase-js": "^2.118.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "prisma": "^6.4.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
